# ---- Raw data -------------------------------------------------------------
# The WFP CSV is redistributable under CC BY-IGO, but it is kept out of git by
# default to avoid committing a large data file. See README "Dataset setup".
data/raw/*.csv
data/raw/*.xlsx
!data/raw/.gitkeep

# ---- Processed data -------------------------------------------------------
# Regenerated by `python run_pipeline.py`.
data/processed/*.parquet
data/processed/*.csv
!data/processed/.gitkeep

# ---- Large model artefacts -----------------------------------------------
# The Random Forest and hybrid pickles are tens of MB. Commit them only if the
# deployment target needs them (see README "Deployment"); the JSON metadata and
# metrics are small and are committed.
models/saved_models/*.joblib
!models/saved_models/.gitkeep

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# ---- Jupyter -------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---- Streamlit -----------------------------------------------------------
.streamlit/secrets.toml

# ---- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Logs ----------------------------------------------------------------
*.log
